    {
      "parameters": {
        "jsCode": "const event = $input.item.json.body.event;\n\n// 1) igual que hoy: tira ruido\nif (event.bot_id || ['bot_message','message_changed','message_deleted'].includes(event.subtype)) {\n  return [];\n}\n\n// 2) de dónde viene (DM → usuario, si no → canal)\nconst routeKey = event.channel_type === 'im' ? event.user : event.channel;\n\n// 3) arrastra el dato de ruteo\nreturn [{ json: { text: JSON.stringify(event), routeKey } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [416, 128],
      "id": "0abf6410-a2b9-4352-9c50-3c9382b98e5f",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "// routeKey (canal o usuario)  ->  rutina\nconst RUTAS = {\n  // \"C0AAA\": { trig: \"trig_aaa\", team: \"QA_A\" },  // canal equipo A\n  // \"U123\":  { trig: \"trig_aaa\", team: \"QA_A\" },  // DM de Fulano -> equipo A\n};\n\n// si el routeKey no está mapeado -> rutina default\nconst r = RUTAS[$json.routeKey] || { trig: \"trig_01636Bhg2PNz4huo35eM9CSz\", team: \"DEFAULT\" };\n\nreturn [{ json: { ...$json, trig: r.trig, team: r.team } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 128],

    {
      "parameters": {
        "jsCode": "const event = $input.item.json.body.event;\n\n// tira ruido (bots / editados / borrados)\nif (event.bot_id || ['bot_message','message_changed','message_deleted'].includes(event.subtype)) {\n  return [];\n}\n\n// de donde viene: DM -> usuario, si no -> canal\nconst routeKey = event.channel_type === 'im' ? event.user : event.channel;\n\nreturn [{ json: { text: JSON.stringify(event), routeKey } }];"
      },

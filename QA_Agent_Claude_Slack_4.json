    {
      "parameters": {
        "jsCode": "// fila encontrada en el Sheet (puede no venir)\nconst filas = $input.all();\nconst equipo = filas.length ? String(filas[0].json.Equipo || '').trim() : '';\n\n// equipo -> rutina (trig + token INLINE)\nconst EQUIPOS = {\n  \"DREAMTEAM\": { trig: \"trig_01636Bhg2PNz4huo35eM9CSz\", token: \"sk-ant-oat01-PEGA_TU_TOKEN\" }, // tu rutina (hoy)\n  \"TADEO\":     { trig: \"TRIG_DE_TADEO_PENDIENTE\",        token: \"PENDIENTE_MANANA\" }           // manana con Tadeo\n};\n\nconst r = EQUIPOS[equipo];\nif (!r) return []; // sin equipo o no mapeado -> no dispara\n\nreturn [{ json: { text: $('Code').first().json.text, trig: r.trig, token: r.token, equipo } }];"
      },
